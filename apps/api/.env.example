# Copy to apps/api/.env for local development. Never commit real secrets.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Local PostgreSQL started by `npm run db:start` (embedded PostgreSQL 17, no Docker needed).
# The app connects as the non-owner role edventure_app (no BYPASSRLS); the owner URL is only for
# migrations, school provisioning and the job-queue schema.
DATABASE_URL=postgres://edventure_app:edventure_app_dev@localhost:54329/edventure
DATABASE_OWNER_URL=postgres://postgres:postgres@localhost:54329/edventure

# Development auth stand-in. Staging/production use AUTH_PROVIDER=supabase.
AUTH_PROVIDER=local
LOCAL_AUTH_SECRET=dev-only-secret-change-me-dev-only-secret-change-me

# Development file storage on disk. Staging/production use STORAGE_PROVIDER=supabase.
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=../../.data/storage
SKIP_MALWARE_SCAN=true

PUBLIC_API_URL=http://localhost:4000
# The admin website (it proxies /api to this server, so cookies stay same-origin).
WEB_ORIGINS=http://localhost:3000

# PDF rendering: a local Chromium-based browser (Edge ships with Windows).
PDF_BROWSER_CHANNEL=msedge

# --- Staging / production (Supabase, Render) ---
# AUTH_PROVIDER=supabase
# STORAGE_PROVIDER=supabase
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_ANON_KEY=...
# SUPABASE_SERVICE_ROLE_KEY=...
# SUPABASE_STORAGE_BUCKET=edventure-private
# AUTH_IDENTITY_DOMAIN=accounts.<your-domain>
# COOKIE_SECURE=true
# EXPO_ACCESS_TOKEN=...
# CLAMAV_HOST=127.0.0.1
# MIN_MOBILE_VERSION=1.0.0
