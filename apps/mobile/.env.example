# The one Edventure API used by the website and this app.
# Optional during local development: the app uses Metro's LAN IP automatically when unset.
# Set this for a tunnel, remote backend, or a non-standard API port.
# Android emulator: http://10.0.2.2:4000 · iOS simulator: http://localhost:4000 · device: http://<your-LAN-IP>:4000
# EXPO_PUBLIC_API_URL=http://<your-LAN-IP>:4000
# Needed for push notifications (Expo push tokens) once the project is linked with `eas init`.
EAS_PROJECT_ID=
