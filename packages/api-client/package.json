{
  "name": "@edventure/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Typed client for the single Edventure API, with separate web (cookie) and mobile (token) transports.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./web": "./src/web.ts",
    "./mobile": "./src/mobile.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@edventure/contracts": "*"
  }
}
